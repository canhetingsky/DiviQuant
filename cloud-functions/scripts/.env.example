# DiviQuant S3 Uploader 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================
# 必填项
# ============================================

# S3 访问密钥 (Access Key ID)
S3_ACCESS_KEY=your_access_key_here

# S3 秘密密钥 (Secret Access Key)
S3_SECRET_KEY=your_secret_key_here

# ============================================
# 可选项（使用默认值可不填）
# ============================================

# S3 端点地址
# 默认值: https://s3.bitiful.net
# S3_ENDPOINT_URL=https://s3.bitiful.net

# S3 存储桶名称
# 默认值: development
# S3_BUCKET_NAME=development

# 上传前缀路径
# 默认值: DiviQuant/
# S3_UPLOAD_PREFIX=DiviQuant/

# 本地数据目录
# 支持相对路径或绝对路径
# 默认值: output/derived
# LOCAL_DATA_DIR=output/derived
# LOCAL_DATA_DIR=C:\Users\name\Documents\DiviQuant\output\derived
